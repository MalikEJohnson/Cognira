# ---------------------------------------------------------------- required

# Get a key from https://console.anthropic.com/settings/keys
# Copy this file to `.env` and paste your key after the "=" sign.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional

# Port the server listens on. Default 3000.
PORT=3000

# ---------------------------------------------------------------- database
#
# Leave BOTH blank for local development — it falls back to a file at
# data/cognira.db and needs no account.
#
# For any serverless host (Vercel), these are REQUIRED. A serverless function
# has no writable disk and is discarded after each request, so a local file
# cannot survive. Create a free database at https://turso.tech, then click
# "Create Token" for the auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Overrides the local file path. Must be a URL, e.g. file:./data/cognira.db
COGNIRA_DB=

# ---------------------------------------------------------------- payments

# The Solana wallet that RECEIVES payments. This is a public address only —
# never put a private key or seed phrase in this file. Payments stay disabled
# until this is set, and the rest of the app still runs without it.
TREASURY_WALLET=

# Solana RPC. The public endpoint is heavily rate limited; use a paid provider
# (Helius, QuickNode, Triton) before taking real traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# USDC mint. Defaults to mainnet USDC. Change it to test on devnet.
USDC_MINT=

# ------------------------------------------------------------------- demo

# Questions an anonymous visitor may ask per hour. Every one costs you money.
DEMO_QUESTIONS_PER_HOUR=5

# Changes how demo visitors are counted. Set it to any random string so the
# stored identifier cannot be reversed back into an IP address.
DEMO_SALT=

# ------------------------------------------------------------- deployment

# Set to "production" behind HTTPS so session cookies are marked Secure.
NODE_ENV=

# Set to any value when running behind a proxy (Fly, Render, nginx), so the
# visitor's real IP is used for demo rate limiting.
TRUST_PROXY=

# ------------------------------------------------------------------ github

# Optional: raises GitHub rate limits, and required for private repos.
# Create one at https://github.com/settings/tokens with the "repo" scope.
GITHUB_TOKEN=

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Cognira</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #0b0d12;
            color: #f5f7fa;
        }

        header {
            padding: 24px 40px;
            border-bottom: 1px solid #222733;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .logo span {
            color: #7c5cff;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 40px 24px;
        }

        .hero {
            margin-bottom: 40px;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .hero p {
            color: #9ca3af;
            font-size: 18px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .card {
            background: #12151d;
            border: 1px solid #252a36;
            border-radius: 16px;
            padding: 24px;
        }

        .card h2 {
            margin-top: 0;
        }

        input,
        textarea {
            width: 100%;
            background: #090b10;
            border: 1px solid #2a3040;
            color: white;
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 12px;
            font-size: 15px;
        }

        textarea {
            min-height: 160px;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #7c5cff;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            opacity: 0.9;
        }

        .answer {
            margin-top: 20px;
            padding: 18px;
            background: #090b10;
            border-radius: 10px;
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .decision {
            border-top: 1px solid #272c38;
            padding: 18px 0;
        }

        .decision:first-child {
            border-top: none;
        }

        .confidence {
            color: #8f9cff;
            font-size: 14px;
        }

        .source {
            color: #8d95a5;
            font-size: 13px;
        }

        @media (max-width: 800px) {

            .grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 36px;
            }

        }

    </style>

</head>

<body>

<header>

    <div class="logo">
        cognir<span>a</span>
    </div>

    <div>
        Institutional Memory AI
    </div>

</header>


<div class="container">

    <section class="hero">

        <h1>
            Your company remembers.
        </h1>

        <p>
            Cognira turns scattered information into searchable
            decision intelligence.
        </p>

    </section>


    <div class="grid">


        <!-- ASK COGNIRA -->

        <div class="card">

            <h2>
                Ask Cognira
            </h2>

            <p>
                Ask why something happened.
            </p>

            <textarea
                id="question"
                placeholder="Why did we choose Stripe?"
            ></textarea>

            <button onclick="askCognira()">
                Ask Cognira
            </button>

            <div
                id="answer"
                class="answer"
                style="display:none;"
            ></div>

        </div>


        <!-- ADD KNOWLEDGE -->

        <div class="card">

            <h2>
                Add Knowledge
            </h2>

            <input
                id="title"
                placeholder="Title"
            >

            <input
                id="source"
                placeholder="Source (meeting, email, Slack, etc.)"
            >

            <textarea
                id="content"
                placeholder="Paste your meeting notes, decision, email, or project information here..."
            ></textarea>

            <button onclick="addKnowledge()">
                Add to Cognira
            </button>

        </div>

    </div>


    <!-- DECISIONS -->

    <div
        class="card"
        style="margin-top:24px;"
    >

        <h2>
            Decision Memory
        </h2>

        <div id="decisions">

            {% for decision in decisions %}

                <div class="decision">

                    <h3>
                        {{ decision["decision"] }}
                    </h3>

                    <p>
                        <strong>Why:</strong>
                        {{ decision["reasoning"] }}
                    </p>

                    <p>
                        <strong>Alternatives:</strong>
                        {{ decision["alternatives"] }}
                    </p>

                    <p>
                        <strong>People:</strong>
                        {{ decision["people"] }}
                    </p>

                    <p class="confidence">

                        Confidence:
                        {{ (decision["confidence"] * 100)|round(1) }}%

                    </p>

                    <p class="source">

                        Source:
                        {{ decision["title"] }}

                    </p>

                </div>

            {% endfor %}

        </div>

    </div>

</div>


<script>


async function addKnowledge() {

    const title =
        document.getElementById("title").value;

    const source =
        document.getElementById("source").value;

    const content =
        document.getElementById("content").value;


    if (!title || !content) {

        alert("Please enter a title and content.");

        return;

    }


    const response = await fetch(
        "/api/knowledge",
        {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                title: title,

                source: source,

                content: content

            })

        }
    );


    const data = await response.json();


    if (data.success) {

        alert(
            "Knowledge added. Cognira analyzed it."
        );

        location.reload();

    } else {

        alert(data.error);

    }

}



async function askCognira() {

    const question =
        document.getElementById("question").value;

    const answerBox =
        document.getElementById("answer");


    if (!question) {

        alert("Ask Cognira a question first.");

        return;

    }


    answerBox.style.display = "block";

    answerBox.innerText =
        "Cognira is reconstructing the decision...";


    const response = await fetch(
        "/api/ask",
        {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({

                question: question

            })

        }
    );


    const data = await response.json();


    if (data.answer) {

        answerBox.innerText =
            data.answer;

    } else {

        answerBox.innerText =
            "Error: " + data.error;

    }

}


</script>


</body>

</html>
